#!/usr/bin/env bash
# The agb-trader stack on the server. deploy.sh ships a copy with each release, and the
# deploy directory's `agb-stack` links to the current one. See docs/build/deploy.md.
#
# The deploy directory:
#   env/               the real env files, which exist only here
#   backups/           the nightly database dumps
#   lake/              the Parquet lake the pipeline lands the vendor's data in
#   panel/             the panel store: filing texts, prompts and responses by sha256
#   models/<model id>/ certified model artifacts, copied from the workstation;
#                      `agb-stack import <model id>` records the certification and
#                      `agb-stack agb promote <model id>` makes the model live
#   releases/<tag>/    compose.yaml and agb-stack as of commit <tag>
#   current, previous  links to the release running now and to the one it replaced
#   healthy            link to the last release that came up healthy; prune never removes it
#   agb-stack          link to current/agb-stack
set -euo pipefail

IMAGE=${AGB_IMAGE:-agb-trader-app}
dir=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)

usage() {
    cat <<'EOF'
usage: agb-stack <command>

  status                          each service's last heartbeat
  agb <args...>                   run an agb CLI command
  import <model id>               record the certification of the artifact in models/<model id>
  tags                            the current and previous release
  activate <tag>                  run the stack on release <tag>; the running one becomes previous.
                                  If <tag> does not come up healthy, the running one comes back
  rollback                        activate the previous release
  restore <dump> [<db>] [--keep]  load a dump into a scratch database (default agb_restore),
                                  compare its row counts with the live database, then drop it
  <anything else>                 passed to docker compose, e.g. `ps` or `logs --follow backup`
EOF
}

die() {
    echo "agb-stack: $*" >&2
    exit 1
}

# The release a link points at, or nothing.
tag_of() {
    if [ -L "$dir/$1" ]; then basename "$(readlink "$dir/$1")"; fi
}

# The server runs the `telegram` profile, vpn and bot, which the workstation leaves out.
compose_at() {
    local tag=$1
    shift
    COMPOSE_PROFILES=telegram \
        AGB_IMAGE=$IMAGE \
        AGB_IMAGE_TAG=$tag \
        AGB_ENV_DIR="$dir/env" \
        AGB_BACKUP_DIR="$dir/backups" \
        AGB_BACKUP_USER="$(id -u):$(id -g)" \
        AGB_LAKE_DIR="$dir/lake" \
        AGB_PANEL_DIR="$dir/panel" \
        AGB_MODELS_DIR="$dir/models" \
        AGB_PIPELINE_USER="$(id -u):$(id -g)" \
        docker compose --project-directory "$dir" --file "$dir/releases/$tag/compose.yaml" \
        --env-file "$dir/env/db.env" "$@"
}

compose() {
    local tag
    tag=$(tag_of current)
    [ -n "$tag" ] || die "nothing is deployed in $dir yet; run scripts/deploy/deploy.sh on the workstation"
    compose_at "$tag" "$@"
}

# Point the link $1 at $2, atomically.
relink() {
    ln -sfn "$2" "$dir/.$1.new"
    mv -T "$dir/.$1.new" "$dir/$1"
}

# Remove every release and image except the current, previous and last healthy ones.
prune() {
    local keep tag rel
    keep=" $(tag_of current) $(tag_of previous) $(tag_of healthy) "
    shopt -s nullglob
    for rel in "$dir"/releases/*/; do
        tag=$(basename "$rel")
        [[ $keep == *" $tag "* ]] || rm -rf -- "$rel"
    done
    docker image ls --format '{{.Tag}}' "$IMAGE" | while read -r tag; do
        [[ $tag == "<none>" || $keep == *" $tag "* ]] && continue
        if docker image rm "$IMAGE:$tag" >/dev/null; then
            echo "removed image $IMAGE:$tag"
        fi
    done
}

# Bring release $1 up and wait until every service reports healthy.
bring_up() {
    compose_at "$1" up --detach --wait --wait-timeout 300 --no-build --pull missing \
        --remove-orphans
}

# Start release $1 and check it: every service healthy, then the certifications made under
# an older cost model voided. A release that changes the cost model invalidates them, and a
# stack that goes on promoting a model certified under the old one is not a healthy deploy.
# Returns 1, after saying why, if either step fails.
start() {
    local tag=$1
    if ! bring_up "$tag"; then
        echo "agb-stack: release $tag did not come up; see \`$dir/agb-stack logs\`" >&2
        return 1
    fi
    if ! compose_at "$tag" run --rm cli void-stale --actor deploy; then
        echo "agb-stack: release $tag could not void stale certifications" >&2
        return 1
    fi
}

# Run the stack on release $1. `current` moves to it only once it is healthy. If it is not,
# the release that was running comes back up and `current`, `previous` and `healthy` are left
# as they were; the command exits non-zero either way.
activate() {
    local tag=$1 current
    [ -f "$dir/releases/$tag/compose.yaml" ] || die "no release $tag in $dir/releases"
    docker image inspect "$IMAGE:$tag" >/dev/null 2>&1 || die "no image $IMAGE:$tag on this host"
    [ -f "$dir/env/db.env" ] || die "no $dir/env/db.env"
    mkdir -p "$dir/backups" "$dir/lake" "$dir/panel" "$dir/models"
    current=$(tag_of current)
    echo "starting release $tag (running: ${current:-nothing})"
    if ! start "$tag"; then
        if [ -z "$current" ]; then
            compose_at "$tag" down >/dev/null 2>&1 || true
            die "release $tag failed and there is no earlier release to return to; the stack is stopped"
        elif [ "$current" = "$tag" ]; then
            die "release $tag failed and is the release that was running; \`$dir/agb-stack rollback\` returns to $(tag_of previous)"
        fi
        echo "agb-stack: returning to release $current" >&2
        bring_up "$current" ||
            die "release $tag failed, and release $current did not come back up; see \`$dir/agb-stack logs\`"
        die "release $tag failed; the stack is back on release $current, which is still current"
    fi
    if [ "$tag" != "$current" ]; then
        if [ -n "$current" ]; then relink previous "releases/$current"; fi
        relink current "releases/$tag"
    fi
    relink agb-stack current/agb-stack
    relink healthy "releases/$tag"
    prune
}

db_psql() {
    compose exec -T db psql --username=postgres --no-psqlrc --set=ON_ERROR_STOP=1 --quiet "$@"
}

# Read-only, as `backup`, which holds pg_read_all_data: a count needs no superuser, and the
# session cannot write.
read_psql() {
    compose exec -T -e PGOPTIONS='-c default_transaction_read_only=on' db \
        psql --username=backup --no-psqlrc --set=ON_ERROR_STOP=1 --quiet "$@"
}

# Rows in every table of database $1, one "schema.table count" line each.
counts() {
    read_psql --dbname="$1" --no-align --tuples-only --field-separator=' ' --command="
        SELECT table_schema || '.' || table_name,
               (xpath('/row/n/text()', query_to_xml(
                   format('SELECT count(*) AS n FROM %I.%I', table_schema, table_name),
                   false, true, '')))[1]::text
        FROM information_schema.tables
        WHERE table_type = 'BASE TABLE'
          AND table_schema NOT IN ('pg_catalog', 'information_schema')
        ORDER BY 1"
}

restore() {
    local dump="" db="" keep=false arg
    for arg in "$@"; do
        case $arg in
        --keep) keep=true ;;
        -*) die "unknown option $arg" ;;
        *)
            if [ -z "$dump" ]; then
                dump=$arg
            elif [ -z "$db" ]; then
                db=$arg
            else
                die "usage: agb-stack restore <dump> [<db>] [--keep]"
            fi
            ;;
        esac
    done
    [ -n "$dump" ] || die "usage: agb-stack restore <dump> [<db>] [--keep]"
    [ -f "$dump" ] || die "no dump $dump"
    db=${db:-agb_restore}
    [[ $db =~ ^[a-z_][a-z0-9_]*$ ]] || die "the database name takes lowercase letters, digits and underscores"
    [ "$db" != agb ] || die "refusing to restore over the live database; docs/build/deploy.md describes a disaster restore"
    gunzip -c -- "$dump" | tail -c 4096 | grep -q -- "-- PostgreSQL database dump complete" ||
        die "$dump is not a complete dump"

    db_psql --dbname=postgres --command="CREATE DATABASE $db"
    if ! $keep; then
        # The trap runs after restore() returns, when its locals are gone, so the name is kept
        # in a global that the single-quoted trap reads when it fires.
        restore_db=$db
        trap 'db_psql --dbname=postgres --command="DROP DATABASE IF EXISTS $restore_db" && echo "dropped $restore_db"' EXIT
    fi
    echo "loading $dump into $db"
    gunzip -c -- "$dump" | db_psql --dbname="$db" >/dev/null
    echo "restored; rows per table:"
    printf '  %-36s %10s %10s\n' table "$db" agb
    awk 'NR == FNR { live[$1] = $2; next }
         { n = ($1 in live) ? live[$1] : "-"
           printf "  %-36s %10s %10s%s\n", $1, $2, n, (n == $2 ? "" : "  differs") }' \
        <(counts agb) <(counts "$db")
    echo "(a table that differs has rows written to the live database since the dump)"
    if $keep; then
        echo "kept $db; drop it with: $dir/agb-stack exec -T db dropdb -U postgres $db"
    fi
}

case ${1:-} in
activate)
    [ $# -eq 2 ] || die "usage: agb-stack activate <tag>"
    activate "$2"
    ;;
rollback)
    previous=$(tag_of previous)
    [ -n "$previous" ] || die "there is no previous release to roll back to"
    activate "$previous"
    ;;
restore)
    shift
    restore "$@"
    ;;
status) compose run --rm cli status ;;
import)
    [ $# -eq 2 ] || die "usage: agb-stack import <model id>"
    # Its own service: only the `research` role may insert a certification.
    compose run --rm certification-import "$2"
    ;;
agb)
    shift
    compose run --rm cli "$@"
    ;;
tags)
    echo "current:  $(tag_of current)"
    echo "previous: $(tag_of previous)"
    echo "healthy:  $(tag_of healthy)"
    ;;
"" | help | -h | --help) usage ;;
*) compose "$@" ;;
esac
