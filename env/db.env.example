# Postgres credentials. `make env` copies this to env/db.env; on the server, replace every
# value before the first `make up`, e.g. with `openssl rand -hex 24`.
#
# Compose reads this file for interpolation (the Makefile passes --env-file), and hands each
# container only the password of its own role.
#
# POSTGRES_PASSWORD takes effect only when the data volume is first created. The role
# passwords below are re-applied by `migrate` on every `up`, so rotating one is: edit, `make up`.

# Superuser. Only `migrate` uses it, to create the roles; no service connects as it.
POSTGRES_PASSWORD=dev-only-postgres

# Owner and migration role. Owns every table; no service connects as it.
AGB_OWNER_PASSWORD=dev-only-owner

# One role per service, plus the operator CLI.
SCHEDULER_DB_PASSWORD=dev-only-scheduler
PIPELINE_DB_PASSWORD=dev-only-pipeline
EXECUTION_DB_PASSWORD=dev-only-execution
BOT_DB_PASSWORD=dev-only-bot
UI_DB_PASSWORD=dev-only-ui
BACKUP_DB_PASSWORD=dev-only-backup
CLI_DB_PASSWORD=dev-only-cli
