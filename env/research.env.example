# Research profile settings, used on the workstation only. deploy.sh never ships this file.
#
# Where `make sync-lake` pulls the lake from: an rsync source of the form host:path, reached
# over the operator's own SSH configuration. The sync only ever reads from it; nothing is
# written back to the server, and the workstation never pulls from the vendor itself.
AGB_LAKE_SOURCE=casaos.local:/mnt/data/AppData/agb-trader/lake
