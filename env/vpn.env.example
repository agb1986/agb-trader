# agb-trader's own gluetun. Fill in env/vpn.env on the server only; never commit it.
# Use a WireGuard key generated for this stack alone: a key shared with another tunnel fails.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
# Egress is outbound-only, so no port forwarding.
VPN_PORT_FORWARDING=off
# The HTTP proxy the bot uses, on port 8888.
HTTPPROXY=on

# How long gluetun waits before it rebuilds the tunnel after a failed health check, and how much
# each further failure adds. The defaults are a few seconds with no growth, so an upstream DNS
# outage makes gluetun tear the tunnel down and back up every few seconds -- which is what broke
# the bot's proxy and the execution service's reads during the outage of 2026-11-08 03:14-03:22Z.
# With these the wait grows 30s, 60s, 90s and the outage is waited out instead.
HEALTH_VPN_DURATION_INITIAL=30s
HEALTH_VPN_DURATION_ADDITION=30s
