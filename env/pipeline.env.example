# Pipeline credentials. Fill in env/pipeline.env on the server only; never commit it.

# Sharadar direct API key, from the sharadar.com account page.
SHARADAR_API_KEY=

# Anthropic API key from the agb-trader workspace, which carries the spend limit.
ANTHROPIC_API_KEY=

# The User-Agent sent to SEC EDGAR on every request, which SEC's fair-access policy requires:
# agb-trader <name> <email>. The panel refuses to start without it. The value holds spaces, so
# quote it: Compose reads this file literally, but a shell that sources it for a live check
# would otherwise run the second word as a command.
EDGAR_USER_AGENT=

# Optional, and normally unset: the capital each basket is sized against, in dollars, as twenty
# equal weights of it in whole shares at the signal session's close. Unset, each basket is sized
# on the account's own equity as execution last read it, which is what the account actually holds.
# Set it only for a run that has to be sized by hand, and unset it again afterwards: a figure left
# here sizes every later basket on a number the account does not hold, which is how the 2026-11
# plan came to be sized on 100000 against 94449.35 of equity.
# AGB_CAPITAL_USD=
