# Pipeline credentials. Fill in env/pipeline.env on the server only; never commit it.

# Sharadar direct API key, from the sharadar.com account page.
SHARADAR_API_KEY=

# Anthropic API key from the agb-trader workspace, which carries the spend limit.
ANTHROPIC_API_KEY=

# The User-Agent sent to SEC EDGAR on every request, which SEC's fair-access policy requires:
# agb-trader <name> <email>. The panel refuses to start without it. The value holds spaces, so
# quote it: Compose reads this file literally, but a shell that sources it for a live check
# would otherwise run the second word as a command.
EDGAR_USER_AGENT=

# The capital each basket is sized against, in dollars. Twenty equal weights of it, in whole
# shares at the signal session's close. Default 100000.
AGB_CAPITAL_USD=100000
