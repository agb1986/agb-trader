# Real env files hold secrets and are never committed; only the .example templates are.
env/*.env
!env/*.env.example
# Database dumps from `make up`'s backup service.
/backups/
# The Parquet lake from `make up`'s pipeline service, or `make sync-lake`'s copy of the
# server's.
/lake/
# The panel store from `make up`'s pipeline service.
/panel/
# The certified model artifacts the pipeline ranks with.
/models/
# The research profile's trial ledger and models.
/research/

